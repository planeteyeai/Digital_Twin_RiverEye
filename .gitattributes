# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# KML files
*.kml text eol=lf
*.xml text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Shell scripts
*.sh text eol=lf
deploy.sh text eol=lf

# Excel files (binary)
*.xlsx binary
*.xls binary

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives (binary)
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.rar binary
*.7z binary

# Large JSON files should use LFS if needed
# Uncomment if archive files are very large
# *.json filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for large data files (optional)
# Uncomment and install git-lfs if you have large historical data files
# naditwin/rivers/*/archive_*.json filter=lfs diff=lfs merge=lfs -text
# naditwin/rivers/*/glofas_history_*.json filter=lfs diff=lfs merge=lfs -text

# Linguist overrides (GitHub language detection)
*.md linguist-detectable
*.py linguist-language=Python
docs/* linguist-documentation
public/* linguist-vendored
